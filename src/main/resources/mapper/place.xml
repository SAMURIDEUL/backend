    <select id="getPlaceByOffset" parameterType="long" resultMap="PlaceResultMap">
        SELECT
        p.id,
        p.name,
        p.category3,
        p.city,
        p.district,
        p.subdistrict,
        p.road_address,
        p.postal_code,
        p.phone,
        p.lat,
        p.lon,
        p.updated_at,
        p.category_id,

        pp.pet_allowed,
        pp.pet_size_limit,
        pp.indoor_flag,
        pp.outdoor_flag,
        pp.pet_restrictions
        FROM places p
        LEFT JOIN place_pet_policies pp ON p.id = pp.place_id
        LIMIT #{offset}, 1
    </select>



