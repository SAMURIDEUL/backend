    <!-- 리뷰 목록 (무한 스크롤) -->
    <select id="getReviewsByPlacePaged" resultType="com.example.samuL.place.dto.PlaceReviewDto">
        SELECT
        id,
        place_id AS placeId,
        user_id AS userId,
        rating,
        content,
        visit_date AS visitDate,
        created_at AS createdAt
        FROM reviews
        WHERE place_id = #{placeId}
        ORDER BY id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- 리뷰별 사진 목록 -->
    <select id="getReviewPhotos" resultType="string">
        SELECT photo_url
        FROM review_photos
        WHERE review_id = #{reviewId}
    </select>

    <!-- 특정 가게의 전체 리뷰 사진 (Top3 사진 추출용) -->
    <select id="getPhotoUrlsByPlaceId" resultType="string">
        SELECT rp.photo_url
        FROM review_photos rp
        JOIN reviews r ON rp.review_id = r.id
        WHERE r.place_id = #{placeId}
    </select>

    <!-- 리뷰 개수 -->
    <select id="countReviewsByPlace" resultType="int">
        SELECT COUNT(*)
        FROM reviews
        WHERE place_id = #{placeId}
    </select>

</mapper>