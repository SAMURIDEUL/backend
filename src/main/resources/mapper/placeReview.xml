<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.samuL.place.mapper.PlaceReviewMapper">

    <resultMap id="PlaceReviewResultMap" type="com.example.samuL.place.dto.PlacePlaceDto">
        <id property="id" column="id" />
        <result property="name" column="name" />
        <result property="category3" column="category3" />
        <result property="city" column="city" />
        <result property="district" column="district" />
        <result property="subdistrict" column="subdistrict" />
        <result property="roadAddress" column="road_address" />
        <result property="postalCode" column="postal_code" />
        <result property="phone" column="phone" />
        <result property="lat" column="lat" />
        <result property="lon" column="lon" />
        <result property="updatedAt" column="updated_at" />
        <result property="categoryId" column="category_id" />
        <result property="parkingAvailable" column="parking_available" />

        <!-- PetPolicyDto를 중첩 객체로 매핑 -->
        <association property="petPolicy" javaType="com.example.samuL.place.dto.PetPolicyDto">
            <result property="petAllowed" column="pet_allowed" />
            <result property="petSizeLimit" column="pet_size_limit" />
            <result property="indoorFlag" column="indoor_flag" />
            <result property="outdoorFlag" column="outdoor_flag" />
            <result property="petRestrictions" column="pet_restrictions" />
        </association>

    </resultMap>

    <select id="getPlaceById" resultMap="PlaceReviewResultMap">
    SELECT
    p.id,
    p.name,
    p.category3,
    p.city,
    p.district,
    p.subdistrict,
    p.road_address,
    p.postal_code,
    p.phone,
    p.lat,
    p.lon,
    p.updated_at,
    p.category_id,
    pp.pet_allowed,
    pp.pet_size_limit,
    pp.indoor_flag,
    pp.outdoor_flag,
    pp.pet_restrictions,
    p.parking_available
    FROM places p
    LEFT JOIN place_pet_policies pp ON p.id = pp.place_id
        WHERE p.id = #{placeId}
    </select>


    <!-- 리뷰 목록 (무한 스크롤) -->
    <select id="getReviewsByPlacePaged" resultType="com.example.samuL.place.dto.PlaceReviewDto">
        SELECT
        r.id,
        r.place_id AS placeId,
        r.user_id AS userId,
        u.nickname AS nickname,
        r.rating,
        r.content,
        r.visit_date AS visitDate,
        r.created_at AS createdAt
        FROM reviews r
        JOIN users u ON r.user_id = u.id
        WHERE r.place_id = #{placeId}
        ORDER BY r.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- 리뷰별 사진 목록 -->
    <select id="getReviewPhotos" resultType="com.example.samuL.review.dto.ReviewPhotoDto">
        SELECT id, review_id AS reviewId, photo_url AS photoUrl
        FROM review_photos
        WHERE review_id = #{reviewId}
    </select>

    <!-- 특정 가게의 전체 리뷰 사진 (Top3 사진 추출용) -->
    <select id="getPhotoUrlsByPlaceId" resultType="string">
        SELECT rp.photo_url
        FROM review_photos rp
        JOIN reviews r ON rp.review_id = r.id
        WHERE r.place_id = #{placeId}
    </select>

    <!-- 리뷰 개수 -->
    <select id="countReviewsByPlace" resultType="int">
        SELECT COUNT(*)
        FROM reviews
        WHERE place_id = #{placeId}
    </select>

</mapper>