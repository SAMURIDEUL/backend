<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.samuL.category.mapper.CategoryMapper">

    <select id="selectAll" resultType="com.example.samuL.category.dto.CategoryDto">
        select id, name, sort_order
        from categories
        order by id;
    </select>

</mapper>